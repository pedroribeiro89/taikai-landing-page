---
import { local } from '../data/content';
---
<section id="local" class="section" aria-labelledby="local-title">
  <div class="container">
    <p class="section__label">Local</p>
    <h2 id="local-title">{local.heading}</h2>
    <p class="local__venue">{local.venue}</p>
    <p class="local__address">{local.address}</p>

    <div class="map">
      <iframe
        src={local.embedUrl}
        title={`Mapa: ${local.venue}`}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>

    <a
      class="btn local__map-link"
      href={local.mapUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Ver no Google Maps
    </a>
  </div>
</section>

<style>
  .local__venue { font-weight: 700; margin: 1rem 0 0.15rem; }
  .local__address { margin: 0 0 1.25rem; color: var(--muted); }
  .map {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    margin-bottom: 1.25rem;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>
